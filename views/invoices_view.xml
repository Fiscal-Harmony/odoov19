<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==========================
         SEARCH View
    =========================== -->
    <record id="view_zimra_invoice_search" model="ir.ui.view">
        <field name="name">zimra.invoice.search</field>
        <field name="model">zimra.invoice</field>
        <field name="arch" type="xml">
            <search string="Search Fiscal Invoices">
                <field name="name"/>
                <field name="zimra_fiscal_number"/>
                <filter string="Pending" name="pending" domain="[('status', '=', 'pending')]"/>
                <filter string="Sent" name="sent" domain="[('status', '=', 'sent')]"/>
                <filter string="Fiscalized" name="fiscalized" domain="[('status', '=', 'fiscalized')]"/>
                <filter string="Failed" name="failed" domain="[('status', '=', 'failed')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('status', '=', 'cancelled')]"/>
                <filter string="POS Orders" name="pos_only" domain="[('pos_order_id', '!=', False)]"/>
                <filter string="Accounting Invoices" name="account_only" domain="[('account_move_id', '!=', False)]"/>
                <filter string="Has Errors" name="has_errors" domain="[('error_message', '!=', False)]"/>
                <filter string="Retried" name="retried" domain="[('retry_count', '>', 0)]"/>
                <group>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ==========================
         LIST View
    =========================== -->
    <record id="view_zimra_invoice_list" model="ir.ui.view">
        <field name="name">zimra.invoice.list</field>
        <field name="model">zimra.invoice</field>
        <field name="arch" type="xml">
            <list decoration-success="status == 'fiscalized'"
                  decoration-danger="status == 'failed'"
                  decoration-warning="status == 'pending'"
                  decoration-info="status == 'sent'"
                  decoration-muted="status == 'cancelled'">
                <header>
                    <button name="action_retry_fiscalization" string="Retry Selected"
                            type="object" class="btn-primary"
                            confirm="Retry fiscalization for all selected failed/cancelled invoices?"/>
                </header>
                <field name="name" string="Invoice"/>
                <field name="pos_order_id" optional="show" string="POS Order"/>
                <field name="account_move_id" optional="show" string="Account Invoice"/>
                <field name="zimra_fiscal_number" string="Fiscal No."/>
                <field name="status" widget="badge"
                       decoration-success="status == 'fiscalized'"
                       decoration-danger="status == 'failed'"
                       decoration-warning="status == 'pending'"
                       decoration-info="status == 'sent'"
                       decoration-muted="status == 'cancelled'"/>
                <field name="retry_count" optional="hide"/>
                <field name="duration" optional="hide" widget="float_time"/>
                <field name="sent_date" optional="show"/>
                <field name="fiscalized_date" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="create_date" string="Created"/>
                <button name="open_downloaded_invoice"
                        type="object"
                        icon="fa-download"
                        string=""
                        invisible="status != 'fiscalized'"
                        title="Download Fiscal PDF"/>
                <button name="action_retry_fiscalization"
                        type="object"
                        icon="fa-refresh"
                        string=""
                        invisible="status not in ('failed', 'cancelled')"
                        title="Retry Fiscalization"/>
            </list>
        </field>
    </record>

    <!-- ==========================
         FORM View
    =========================== -->
    <record id="view_zimra_invoice_form" model="ir.ui.view">
        <field name="name">zimra.invoice.form</field>
        <field name="model">zimra.invoice</field>
        <field name="arch" type="xml">
            <form string="Fiscal Invoice">
                <header>
                    <button name="action_retry_fiscalization"
                            string="Retry Fiscalization"
                            type="object"
                            class="btn-primary"
                            invisible="status not in ('failed','cancelled')"
                            icon="fa-refresh"/>
                    <button name="action_cancel_fiscalization"
                            string="Cancel"
                            type="object"
                            class="btn-secondary"
                            invisible="status in ('fiscalized', 'cancelled')"
                            confirm="Are you sure you want to cancel this fiscalization?"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="pending,sent,fiscalized"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_related_document"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-shopping-cart"
                                invisible="not pos_order_id">
                            <span class="o_stat_info">
                                <span class="o_stat_text">View POS Order</span>
                            </span>
                        </button>
                        <button name="action_view_related_document"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-file-text-o"
                                invisible="not account_move_id">
                            <span class="o_stat_info">
                                <span class="o_stat_text">View Invoice</span>
                            </span>
                        </button>
                        <button name="open_downloaded_invoice"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-download"
                                invisible="status != 'fiscalized'">
                            <span class="o_stat_info">
                                <span class="o_stat_text">Download PDF</span>
                            </span>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Invoice Number"/>
                        </h1>
                    </div>

                    <div class="oe_form_container">
                        <group>
                            <group string="Invoice Details">
                                <field name="pos_order_id"/>
                                <field name="account_move_id"/>
                                <field name="zimra_fiscal_number"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                            <group string="Timeline">
                                <field name="create_date"/>
                                <field name="sent_date"/>
                                <field name="fiscalized_date"/>
                                <field name="retry_count"/>
                                <field name="duration" widget="float_time"/>
                            </group>
                        </group>

                        <group string="Request Data">
                            <field name="request_data" nolabel="1" placeholder="No request data available"/>
                        </group>
                        <group string="Response Data">
                            <field name="response_data" nolabel="1" placeholder="No response data available"/>
                        </group>
                        <group string="Error Details" invisible="not error_message">
                            <field name="error_message" nolabel="1" placeholder="No errors"/>
                        </group>
                    </div>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ==========================
         KANBAN View
    =========================== -->
    <record id="view_zimra_invoice_kanban" model="ir.ui.view">
        <field name="name">zimra.invoice.kanban</field>
        <field name="model">zimra.invoice</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_small_column" sample="1">
                <field name="name"/>
                <field name="pos_order_id"/>
                <field name="account_move_id"/>
                <field name="zimra_fiscal_number"/>
                <field name="status"/>
                <field name="retry_count"/>
                <field name="error_message"/>
                <field name="create_date"/>
                <field name="fiscalized_date"/>
                <field name="duration"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top mb-2">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <div class="o_kanban_record_top_right">
                                    <field name="status" widget="label_selection"
                                           options="{'classes': {
                                               'pending': 'warning',
                                               'sent': 'info',
                                               'fiscalized': 'success',
                                               'failed': 'danger',
                                               'cancelled': 'default'
                                           }}"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_body mb-2">
                                <div t-if="record.pos_order_id.raw_value" class="mb-1">
                                    <span class="fa fa-shopping-cart text-muted me-1" title="POS Order"/>
                                    <field name="pos_order_id"/>
                                </div>
                                <div t-if="record.account_move_id.raw_value" class="mb-1">
                                    <span class="fa fa-file-text-o text-muted me-1" title="Account Invoice"/>
                                    <field name="account_move_id"/>
                                </div>
                                <div t-if="record.zimra_fiscal_number.raw_value" class="mb-1">
                                    <span class="fa fa-barcode text-success me-1" title="Fiscal Number"/>
                                    <field name="zimra_fiscal_number"/>
                                </div>
                                <div t-if="record.retry_count.raw_value and record.retry_count.raw_value > 0" class="mb-1">
                                    <span class="fa fa-refresh text-warning me-1" title="Retries"/>
                                    Retries: <field name="retry_count"/>
                                </div>
                                <div t-if="record.error_message.raw_value" class="text-danger small mt-1">
                                    <span class="fa fa-exclamation-triangle me-1" title="Error"/>
                                    Has errors
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom mt-auto pt-2 border-top">
                                <div class="oe_kanban_bottom_left">
                                    <field name="create_date" widget="date"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <div t-if="record.fiscalized_date.raw_value">
                                        <span class="fa fa-check-circle text-success" title="Fiscalized"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ==========================
         MAIN ACTION
    =========================== -->
    <record id="action_zimra_invoice" model="ir.actions.act_window">
        <field name="name">Fiscal Invoices</field>
        <field name="res_model">zimra.invoice</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_group_status': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No fiscal invoices yet!</p>
            <p>Invoices are automatically created when POS orders or accounting invoices are fiscalized.</p>
        </field>
    </record>

    <menuitem id="menu_zimra_invoice" name="Fiscal Invoices" parent="menu_zimra_config_root"
              action="action_zimra_invoice" sequence="20"/>

    <!-- ==========================
         FILTERED ACTIONS
    =========================== -->
    <record id="action_zimra_invoice_failed" model="ir.actions.act_window">
        <field name="name">Failed Invoices</field>
        <field name="res_model">zimra.invoice</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('status', '=', 'failed')]</field>
        <field name="context">{'search_default_failed': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No failed invoices!</p>
            <p>Invoices that failed fiscalization. Use the Retry button to try again.</p>
        </field>
    </record>
    <menuitem id="menu_zimra_invoice_failed" name="Failed Invoices" parent="menu_zimra_invoice"
              action="action_zimra_invoice_failed" sequence="10"/>

    <record id="action_zimra_invoice_pending" model="ir.actions.act_window">
        <field name="name">Pending Invoices</field>
        <field name="res_model">zimra.invoice</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('status', 'in', ['pending', 'sent'])]</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No pending invoices!</p>
            <p>Invoices waiting for fiscalization or currently being processed.</p>
        </field>
    </record>
    <menuitem id="menu_zimra_invoice_pending" name="Pending Invoices" parent="menu_zimra_invoice"
              action="action_zimra_invoice_pending" sequence="5"/>

    <record id="action_zimra_invoice_fiscalized" model="ir.actions.act_window">
        <field name="name">Fiscalized Invoices</field>
        <field name="res_model">zimra.invoice</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('status', '=', 'fiscalized')]</field>
        <field name="context">{'search_default_fiscalized': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No fiscalized invoices yet!</p>
            <p>Successfully fiscalized invoices will appear here.</p>
        </field>
    </record>
    <menuitem id="menu_zimra_invoice_fiscalized" name="Fiscalized Invoices" parent="menu_zimra_invoice"
              action="action_zimra_invoice_fiscalized" sequence="15"/>

    <!-- ==========================
         ACCOUNTING INVOICES (Never Fiscalized)
    =========================== -->
    <record id="action_accounting_invoice_never_fiscalized" model="ir.actions.act_window">
        <field name="name">Accounting Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', 'in', ['out_invoice', 'out_refund']), ('state', '=', 'posted')]</field>
        <field name="context">{'search_default_never_fiscalized': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No accounting invoices found!</p>
            <p>Posted customer invoices and credit notes will appear here.</p>
        </field>
    </record>
    <menuitem id="menu_zimra_invoice_never_fiscalized" name="Accounting Invoices"
              parent="menu_zimra_invoice" action="action_accounting_invoice_never_fiscalized" sequence="25"/>

    <!-- ==========================
         INHERIT account.move FORM
    =========================== -->
    <record id="view_account_move_form_inherit_zimra" model="ir.ui.view">
        <field name="name">account.move.form.inherit.zimra</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="zimra_status" invisible="1"/>
                <field name="zimra_qr_code" invisible="1"/>
                <field name="zimra_verification_url" invisible="1"/>
                <field name="fiscal_pdf_attachment_id" invisible="1"/>
            </xpath>

            <xpath expr="//header" position="inside">
                <button name="action_fiscalize_invoice"
                        string="Fiscalize Invoice"
                        type="object"
                        class="btn-primary"
                        invisible="move_type not in ('out_invoice', 'out_refund') or state != 'posted' or zimra_status in ('fiscalized', 'sent')"
                        confirm="Are you sure you want to fiscalize this invoice with ZIMRA?"/>
                <button name="action_download_fiscal_pdf"
                        string="Download Fiscal Invoice"
                        type="object"
                        class="btn-primary"
                        invisible="zimra_status not in ('fiscalized')"/>
            </xpath>
        </field>
    </record>

</odoo>
