<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zimra_config_form" model="ir.ui.view">
        <field name="name">zimra.config.form</field>
        <field name="model">zimra.config</field>
        <field name="arch" type="xml">
            <form string="Fiscal Harmony API Configuration">
                <header>
                    <button name="test_connection" string="Test Connection" type="object" class="btn-primary" icon="fa-plug"/>
                    <button name="sync_device_taxes" string="Sync Device Taxes" type="object" class="btn-secondary" icon="fa-refresh"/>
                    <field name="active" widget="boolean_toggle"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_pos_orders" icon="fa-shopping-cart">
                            <field name="total_sent" widget="statinfo" string="POS Orders"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_failed_orders" icon="fa-exclamation-triangle">
                            <field name="total_failed" widget="statinfo" string="Failed"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="sync_device_taxes" icon="fa-refresh">
                            <span class="o_stat_info">
                                <span class="o_stat_text">Taxes Synced</span>
                            </span>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g., Main Branch Configuration"/>
                        </h1>
                    </div>

                    <notebook>
                        <page string="API Settings" name="api_settings" icon="fa-key">
                            <div class="row mt-4 g-4">
                                <div class="col-lg-7">
                                    <div class="card border-0 shadow-sm mb-4">
                                        <div class="card-body p-4">
                                            <div class="d-flex align-items-center mb-3">
                                                <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3">
                                                    <span class="fa fa-cloud fa-lg text-primary" title="Connection"/>
                                                </div>
                                                <div>
                                                    <h5 class="mb-0 fw-semibold">API Connection</h5>
                                                    <small class="text-muted">Fiscal Harmony endpoint configuration</small>
                                                </div>
                                            </div>
                                            <div class="row g-3 mb-3">
                                                <div class="col-md-6">
                                                    <span class="o_form_label mb-1 d-block">Multi-Branch Mode</span>
                                                    <field name="multi_branch" widget="boolean_toggle"/>
                                                </div>
                                                <div class="col-md-6">
                                                    <span class="o_form_label mb-1 d-block">Warehouse</span>
                                                    <field name="warehouse_id" class="form-control"
                                                           options="{'no_create': True}"
                                                           help="Required when Multi-Branch Mode is ON. Leave empty for shared config."/>
                                                </div>
                                            </div>
                                            <div class="mb-3">
                                                <span class="o_form_label mb-1 d-block">API URL</span>
                                                <field name="api_url" class="form-control"
                                                       placeholder="https://api.fiscalharmony.co.zw/api"
                                                       help="The base URL for Fiscal Harmony API endpoints"/>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <span class="o_form_label mb-1 d-block">User ID</span>
                                                    <field name="userId" class="form-control"
                                                           help="Your Fiscal Harmony user identifier"/>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="card border-0 shadow-sm mb-4">
                                        <div class="card-body p-4">
                                            <div class="d-flex align-items-center mb-3">
                                                <div class="rounded-circle bg-dark bg-opacity-10 p-3 me-3">
                                                    <span class="fa fa-shield fa-lg text-dark" title="Security"/>
                                                </div>
                                                <div>
                                                    <h5 class="mb-0 fw-semibold">API Credentials</h5>
                                                    <small class="text-muted">Secure authentication keys</small>
                                                </div>
                                            </div>
                                            <div class="row g-3">
                                                <div class="col-md-6">
                                                    <span class="o_form_label">API Key</span>
                                                    <field name="api_key" password="True" class="form-control"
                                                           placeholder="Enter your API key"
                                                           help="Unique API key for authentication"/>
                                                </div>
                                                <div class="col-md-6">
                                                    <span class="o_form_label">API Secret</span>
                                                    <field name="api_secret" password="True" class="form-control"
                                                           placeholder="Enter your API secret"
                                                           help="Secret key used for request signing"/>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="card border-0 shadow-sm mb-4">
                                        <div class="card-body p-4">
                                            <div class="d-flex align-items-center mb-3">
                                                <div class="rounded-circle bg-secondary bg-opacity-10 p-3 me-3">
                                                    <span class="fa fa-sliders fa-lg text-secondary" title="Settings"/>
                                                </div>
                                                <div>
                                                    <h5 class="mb-0 fw-semibold">Request Settings</h5>
                                                    <small class="text-muted">Timeout, retry and automation</small>
                                                </div>
                                            </div>
                                            <div class="row g-3">
                                                <div class="col-md-3">
                                                    <span class="o_form_label">Timeout (sec)</span>
                                                    <field name="timeout" class="form-control"
                                                           help="HTTP request timeout in seconds"/>
                                                </div>
                                                <div class="col-md-3">
                                                    <span class="o_form_label">Poll Delay (sec)</span>
                                                    <field name="poll_delay" class="form-control"
                                                           help="Seconds to wait before polling fiscalisation status"/>
                                                </div>
                                                <div class="col-md-3">
                                                    <span class="o_form_label">Retry Count</span>
                                                    <field name="retry_count" class="form-control"
                                                           help="Number of times to retry failed requests"/>
                                                </div>
                                                <div class="col-md-3">
                                                    <span class="o_form_label">Auto Fiscalize</span>
                                                    <div class="pt-1">
                                                        <field name="auto_fiscalize" widget="boolean_toggle"
                                                               help="Automatically fiscalize POS orders when paid"/>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-5">
                                    <div class="card border-0 shadow-sm mb-4">
                                        <div class="card-body p-4">
                                            <div class="d-flex align-items-center mb-3">
                                                <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3">
                                                    <span class="fa fa-signal fa-lg text-success" title="Status"/>
                                                </div>
                                                <div>
                                                    <h5 class="mb-0 fw-semibold">Connection Status</h5>
                                                    <small class="text-muted">Last sync activity</small>
                                                </div>
                                            </div>
                                            <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded mb-3">
                                                <div>
                                                    <div class="small text-muted mb-1">Taxes Synced</div>
                                                    <field name="device_taxes_synced" widget="boolean_toggle"/>
                                                </div>
                                                <span class="fa fa-database text-primary fa-lg" title="Database"/>
                                            </div>
                                            <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded">
                                                <div>
                                                    <div class="small text-muted mb-1">Last Successful Request</div>
                                                    <field name="last_successful_request" readonly="1"/>
                                                </div>
                                                <span class="fa fa-check-circle text-info fa-lg" title="Last Request"/>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="card border-0 shadow-sm mb-4">
                                        <div class="card-body p-4">
                                            <div class="d-flex align-items-center mb-3">
                                                <div class="rounded-circle bg-info bg-opacity-10 p-3 me-3">
                                                    <span class="fa fa-bar-chart fa-lg text-info" title="Statistics"/>
                                                </div>
                                                <div>
                                                    <h5 class="mb-0 fw-semibold">Quick Stats</h5>
                                                    <small class="text-muted">Fiscalisation overview</small>
                                                </div>
                                            </div>
                                            <div class="row g-2 text-center">
                                                <div class="col-4">
                                                    <div class="p-3 bg-primary bg-opacity-10 rounded">
                                                        <div class="fs-4 fw-bold text-primary">
                                                            <field name="total_sent" readonly="1"/>
                                                        </div>
                                                        <div class="small text-muted">Sent</div>
                                                    </div>
                                                </div>
                                                <div class="col-4">
                                                    <div class="p-3 bg-success bg-opacity-10 rounded">
                                                        <div class="fs-4 fw-bold text-success">
                                                            <field name="total_fiscalized" readonly="1"/>
                                                        </div>
                                                        <div class="small text-muted">Fiscalized</div>
                                                    </div>
                                                </div>
                                                <div class="col-4">
                                                    <div class="p-3 bg-danger bg-opacity-10 rounded">
                                                        <div class="fs-4 fw-bold text-danger">
                                                            <field name="total_failed" readonly="1"/>
                                                        </div>
                                                        <div class="small text-muted">Failed</div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="card border-0 shadow-sm">
                                        <div class="card-body p-4">
                                            <div class="d-flex align-items-center mb-3">
                                                <div class="rounded-circle bg-warning bg-opacity-10 p-3 me-3">
                                                    <span class="fa fa-bolt fa-lg text-warning" title="Actions"/>
                                                </div>
                                                <div>
                                                    <h5 class="mb-0 fw-semibold">Quick Actions</h5>
                                                    <small class="text-muted">Common operations</small>
                                                </div>
                                            </div>
                                            <div class="d-grid gap-2">
                                                <button name="test_connection" type="object" class="btn btn-outline-primary text-start">
                                                    <span class="fa fa-plug me-2" title="Test"/>
                                                    Test API Connection
                                                </button>
                                                <button name="sync_device_taxes" type="object" class="btn btn-outline-success text-start">
                                                    <span class="fa fa-refresh me-2" title="Sync"/>
                                                    Sync Device Taxes
                                                </button>
                                                <button name="action_view_pos_orders" type="object" class="btn btn-outline-secondary text-start">
                                                    <span class="fa fa-shopping-cart me-2" title="POS"/>
                                                    View POS Orders
                                                </button>
                                                <button name="action_view_failed_orders" type="object" class="btn btn-outline-danger text-start">
                                                    <span class="fa fa-exclamation-triangle me-2" title="Failed"/>
                                                    View Failed Orders
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </page>

                        <page string="Device Sync" name="device_sync" icon="fa-refresh">
                            <div class="row mt-4 g-4">
                                <div class="col-lg-5">
                                    <div class="card border-0 shadow-sm mb-4">
                                        <div class="card-body p-4">
                                            <div class="d-flex align-items-center mb-4">
                                                <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3">
                                                    <span class="fa fa-sync fa-lg text-success" title="Sync Status"/>
                                                </div>
                                                <div>
                                                    <h5 class="mb-0 fw-semibold">Device Sync Status</h5>
                                                    <small class="text-muted">Fiscal device synchronisation overview</small>
                                                </div>
                                            </div>

                                            <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded mb-3">
                                                <div>
                                                    <div class="small text-muted mb-1">Taxes Synced</div>
                                                    <field name="device_taxes_synced" widget="boolean_toggle"/>
                                                </div>
                                                <span class="fa fa-database text-primary fa-lg" title="Database"/>
                                            </div>

                                            <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded mb-3">
                                                <div>
                                                    <div class="small text-muted mb-1">Last Tax Sync</div>
                                                    <field name="last_tax_sync" readonly="1"/>
                                                </div>
                                                <span class="fa fa-clock-o text-muted fa-lg" title="Last Sync"/>
                                            </div>

                                            <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded mb-4">
                                                <div>
                                                    <div class="small text-muted mb-1">Last Successful Request</div>
                                                    <field name="last_successful_request" readonly="1"/>
                                                </div>
                                                <span class="fa fa-check-circle text-info fa-lg" title="Last Request"/>
                                            </div>

                                            <button name="sync_device_taxes" type="object" class="btn btn-success w-100">
                                                <span class="fa fa-refresh me-2" title="Sync"/>
                                                Sync Device Taxes
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-7">
                                    <div class="card border-0 shadow-sm mb-4">
                                        <div class="card-body p-4">
                                            <div class="d-flex align-items-center mb-4">
                                                <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3">
                                                    <span class="fa fa-percent fa-lg text-primary" title="Tax Mappings"/>
                                                </div>
                                                <div>
                                                    <h5 class="mb-0 fw-semibold">Mapped Taxes</h5>
                                                    <small class="text-muted">ZIMRA tax codes linked to Odoo taxes</small>
                                                </div>
                                            </div>
                                            <field name="tax_mapping_ids"
                                                   context="{'default_config_id': id,
                                                             'list_view_ref': 'odoov19.view_zimra_tax_mapping_list',
                                                             'form_view_ref': 'odoov19.view_zimra_tax_mapping_form'}"/>
                                        </div>
                                    </div>

                                    <div class="card border-0 shadow-sm">
                                        <div class="card-body p-4">
                                            <div class="d-flex align-items-center mb-4">
                                                <div class="rounded-circle bg-warning bg-opacity-10 p-3 me-3">
                                                    <span class="fa fa-money fa-lg text-warning" title="Currency Mappings"/>
                                                </div>
                                                <div>
                                                    <h5 class="mb-0 fw-semibold">Mapped Currencies</h5>
                                                    <small class="text-muted">ZIMRA currency codes linked to Odoo currencies</small>
                                                </div>
                                            </div>
                                            <field name="currency_mapping_ids"
                                                   context="{'default_config_id': id,
                                                             'list_view_ref': 'odoov19.view_zimra_currency_mapping_list',
                                                             'form_view_ref': 'odoov19.view_zimra_currency_mapping_form'}"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </page>

                        <page string="Statistics" name="statistics" icon="fa-bar-chart">
                            <div class="row mt-4 g-4">
                                <div class="col-lg-4">
                                    <div class="card border-0 shadow-sm text-bg-primary">
                                        <div class="card-body p-4 text-center">
                                            <span class="fa fa-paper-plane fa-2x mb-2 opacity-75" title="Sent"/>
                                            <h6 class="card-title opacity-75">Total Sent</h6>
                                            <div class="display-6 fw-bold">
                                                <field name="total_sent" readonly="1"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-4">
                                    <div class="card border-0 shadow-sm text-bg-success">
                                        <div class="card-body p-4 text-center">
                                            <span class="fa fa-check-circle fa-2x mb-2 opacity-75" title="Fiscalized"/>
                                            <h6 class="card-title opacity-75">Fiscalized</h6>
                                            <div class="display-6 fw-bold">
                                                <field name="total_fiscalized" readonly="1"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-4">
                                    <div class="card border-0 shadow-sm text-bg-danger">
                                        <div class="card-body p-4 text-center">
                                            <span class="fa fa-times-circle fa-2x mb-2 opacity-75" title="Failed"/>
                                            <h6 class="card-title opacity-75">Failed</h6>
                                            <div class="display-6 fw-bold">
                                                <field name="total_failed" readonly="1"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_zimra_config_list" model="ir.ui.view">
        <field name="name">zimra.config.list</field>
        <field name="model">zimra.config</field>
        <field name="arch" type="xml">
            <list string="ZIMRA Configurations">
                <field name="name"/>
                <field name="company_id"/>
                <field name="warehouse_id"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="userId"/>
                <field name="device_taxes_synced" widget="boolean_toggle"/>
                <field name="last_tax_sync"/>
                <field name="total_fiscalized" string="Fiscalized"/>
                <field name="total_failed" string="Failed" decoration-danger="total_failed > 0"/>
            </list>
        </field>
    </record>

    <record id="view_zimra_tax_mapping_form" model="ir.ui.view">
        <field name="name">zimra.tax.mapping.form</field>
        <field name="model">zimra.tax.mapping</field>
        <field name="arch" type="xml">
            <form string="Tax Mapping">
                <sheet>
                    <group>
                        <group>
                            <field name="config_id" readonly="1"/>
                            <field name="zimra_tax_code"/>
                            <field name="zimra_tax_name"/>
                            <field name="zimra_tax_rate"/>
                        </group>
                        <group>
                            <field name="zimra_tax_type"/>
                            <field name="odoo_tax_id" domain="[('company_id', '=', parent.company_id)]"/>
                            <field name="is_active"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="tax_description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_zimra_tax_mapping_list" model="ir.ui.view">
        <field name="name">zimra.tax.mapping.list</field>
        <field name="model">zimra.tax.mapping</field>
        <field name="arch" type="xml">
            <list string="Tax Mappings" editable="bottom">
                <field name="config_id" readonly="1" optional="hide"/>
                <field name="zimra_tax_code"/>
                <field name="zimra_tax_name"/>
                <field name="zimra_tax_rate"/>
                <field name="zimra_tax_type"/>
                <field name="odoo_tax_id"/>
                <field name="is_active" widget="boolean_toggle"/>
                <button name="save_line_taxmapping" string="Save" type="object"
                    icon="fa-save" class="btn-primary"/>
            </list>
        </field>
    </record>

    <record id="view_zimra_currency_mapping_form" model="ir.ui.view">
        <field name="name">zimra.currency.mapping.form</field>
        <field name="model">zimra.currency.mapping</field>
        <field name="arch" type="xml">
            <form string="Currency Mapping">
                <sheet>
                    <group>
                        <field name="config_id" readonly="1"/>
                        <field name="odoo_currency_id"/>
                        <field name="zimra_currency_code"/>
                        <field name="is_active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_zimra_currency_mapping_list" model="ir.ui.view">
        <field name="name">zimra.currency.mapping.list</field>
        <field name="model">zimra.currency.mapping</field>
        <field name="arch" type="xml">
            <list string="Currency Mappings" editable="bottom">
                <field name="config_id" readonly="1" optional="hide"/>
                <field name="odoo_currency_id"/>
                <field name="zimra_currency_code"/>
                <field name="is_active" widget="boolean_toggle"/>
                <button name="save_line_currencymapping" string="Save" type="object"
                    icon="fa-save" class="btn-primary"/>
            </list>
        </field>
    </record>

    <record id="action_zimra_tax_mapping" model="ir.actions.act_window">
        <field name="name">Tax Mappings</field>
        <field name="res_model">zimra.tax.mapping</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_current_company': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No tax mappings found!</p>
            <p>Applicable taxes are automatically fetched when you sync device taxes from ZIMRA.</p>
            <p>Map applicable taxes against your own Odoo taxes.</p>
        </field>
    </record>

    <record id="action_zimra_config" model="ir.actions.act_window">
        <field name="name">Fiscal Harmony Configurations</field>
        <field name="res_model">zimra.config</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1, 'search_default_current_company': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first Fiscal Harmony configuration!</p>
            <p>Each company/branch requires its own configuration.</p>
            <p>Configure your Fiscal Integration API settings including API keys, tax mappings, and currency mappings.</p>
            <p><strong>Note:</strong> Switch to the desired company/branch before creating a configuration.</p>
        </field>
    </record>
</odoo>
