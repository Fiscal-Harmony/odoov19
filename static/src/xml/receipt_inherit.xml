<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('before-footer')]" position="before">
            <!-- ZIMRA Fiscal Section -->
            <div t-if="order.zimra_qr_code" class="text-center mt-3 border-top pt-2">
                <div class="fw-bold mb-1">ZIMRA Fiscal Receipt</div>
                <img
                    t-att-src="env.services.pos.getZimraQrCode(order)"
                    style="width: 130px; height: 130px;"
                />
                <div class="small mt-1">
                    Fiscal Day: <t t-esc="order.zimra_fiscal_number"/>
                </div>
                <div t-if="order.zimra_verification_code" class="small mt-1">
                    Code: <t t-esc="order.zimra_verification_code"/>
                </div>
            </div>
        </xpath>
    </t>
</templates>
