<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- Retry Failed POS Orders -->
        <record id="ir_cron_retry_failed_pos" model="ir.cron">
            <field name="name">Fiscal: Retry Failed POS Orders</field>
            <field name="model_id" ref="point_of_sale.model_pos_order"/>
            <field name="state">code</field>
            <field name="code">model.cron_retry_failed_fiscalization()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
        </record>

        <!-- Retry Failed Accounting Invoices -->
        <record id="ir_cron_retry_failed_invoices" model="ir.cron">
            <field name="name">Fiscal: Retry Failed Invoices</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="state">code</field>
            <field name="code">model.cron_retry_failed_fiscalization()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
        </record>

        <!-- Sync Device Taxes -->
        <record id="ir_cron_sync_device_taxes" model="ir.cron">
            <field name="name">Fiscal: Sync Device Taxes</field>
            <field name="model_id" ref="model_zimra_config"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_device_taxes()</field>
            <field name="interval_number">24</field>
            <field name="interval_type">hours</field>
        </record>
    </data>
</odoo>
